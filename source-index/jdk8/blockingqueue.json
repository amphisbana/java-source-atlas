  "evidence": [
    {
      "id": "array-put-main",
      "kind": "main",
      "claim": "有界 ArrayBlockingQueue 满时 put 会等待，take 释放容量后生产者才能继续。",
      "entryPoint": "ArrayBlockingQueue.put(E)",
      "document": "/jdk/concurrent/blockingqueue/array-linked#arrayblockingqueue-put-的等待路径",
      "labMethod": "observeArrayQueuePutWait",
      "testClass": "io.github.javasourceatlas.jdk.concurrent.BlockingQueueBehaviorTest",
      "testMethod": "shouldResumeArrayQueuePutAfterTakeCreatesCapacity",
      "expectedOutcome": "生产者先进入 WAITING，消费者取走一个元素后 put 完成且队列仍满足容量约束。"
    },
    {
      "id": "method-family-boundary",
      "kind": "boundary",
      "claim": "BlockingQueue 的异常、特殊值、阻塞和超时四组 API 在满队列与空队列边界具有不同结果。",
      "entryPoint": "BlockingQueue.put(E)",
      "document": "/jdk/concurrent/blockingqueue/#四组方法如何选择",
      "labMethod": "observeMethodFamilies",
      "testClass": "io.github.javasourceatlas.jdk.concurrent.BlockingQueueBehaviorTest",
      "testMethod": "shouldExposeExceptionAndSpecialValueFamilies",
      "expectedOutcome": "add/remove 抛异常，offer/poll 返回特殊值，边界行为与接口契约一致。"
    },
    {
      "id": "synchronous-handoff-concurrency",
      "kind": "concurrency",
      "claim": "SynchronousQueue 不存储元素，put 必须与另一个线程的 take 直接配对。",
      "entryPoint": "SynchronousQueue.Transferer.transfer(E,boolean,long)",
      "document": "/jdk/concurrent/blockingqueue/synchronousqueue#所有操作汇入-transfer",
      "labMethod": "observeSynchronousHandoff",
      "testClass": "io.github.javasourceatlas.jdk.concurrent.BlockingQueueBehaviorTest",
      "testMethod": "shouldHandoffInFairAndNonfairModes",
      "expectedOutcome": "公平与非公平模式都只在消费者到达后完成交接，队列容量始终为零。"
    }
