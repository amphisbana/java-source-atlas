  "evidence": [
    {
      "id": "zero-delay-main",
      "kind": "main",
      "claim": "execute 也会被包装成零延迟 ScheduledFutureTask，再进入同一延迟队列。",
      "entryPoint": "schedule(Runnable,long,TimeUnit)",
      "document": "/jdk/concurrent/scheduledthreadpoolexecutor/#schedule-的完整调用链",
      "labMethod": "observeZeroDelayWrapping",
      "testClass": "io.github.javasourceatlas.jdk.concurrent.ScheduledThreadPoolExecutorBehaviorTest",
      "testMethod": "shouldWrapExecuteCommandAsZeroDelayScheduledFuture",
      "expectedOutcome": "execute 提交的命令以 ScheduledFuture 形态运行，延迟为零且最终进入完成态。"
    },
    {
      "id": "fixed-rate-boundary",
      "kind": "boundary",
      "claim": "固定频率任务不会并发重叠；执行超时时下一轮在前一轮结束后尽快继续。",
      "entryPoint": "scheduleAtFixedRate(Runnable,long,long,TimeUnit)",
      "document": "/jdk/concurrent/scheduledthreadpoolexecutor/#周期任务为什么要保存-outertask",
      "labMethod": "observeFixedRateWithoutOverlap",
      "testClass": "io.github.javasourceatlas.jdk.concurrent.ScheduledThreadPoolExecutorBehaviorTest",
      "testMethod": "shouldNotOverlapFixedRateExecutions",
      "expectedOutcome": "最大并发执行数始终为 1，即使单次执行时间超过 period。"
    },
    {
      "id": "periodic-failure",
      "kind": "failure",
      "claim": "周期任务一次执行抛异常后不会再次 reExecutePeriodic，Future 进入异常完成态。",
      "entryPoint": "ScheduledFutureTask.run()",
      "document": "/jdk/concurrent/scheduledthreadpoolexecutor/periodic-cancel#run-的三条分支",
      "labMethod": "observePeriodicException",
      "testClass": "io.github.javasourceatlas.jdk.concurrent.ScheduledThreadPoolExecutorBehaviorTest",
      "testMethod": "shouldStopPeriodicExecutionAfterException",
      "expectedOutcome": "任务只执行一次，后续周期停止，get 通过 ExecutionException 暴露原始失败。"
    }
  ],
