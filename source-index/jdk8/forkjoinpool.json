      "entryPoint": "ForkJoinTask.doJoin()",
      "document": "/jdk/concurrent/forkjoinpool/fork-join#dojoin-的完整决策",
      "labMethod": "observeExceptionReporting",
      "testClass": "io.github.javasourceatlas.jdk.concurrent.ForkJoinPoolBehaviorTest",
      "testMethod": "shouldReportJoinAndGetFailuresDifferently",
      "expectedOutcome": "join 抛运行时失败，get 通过 ExecutionException 暴露同一失败原因。"
    }
