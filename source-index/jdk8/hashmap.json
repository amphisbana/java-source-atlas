  "evidence": [
    {
      "id": "put-main",
      "kind": "main",
      "claim": "HashMap 为已有 key 写入新值时只替换 value，不增加映射数量。",
      "entryPoint": "putVal(int,K,V,boolean,boolean)",
      "document": "/jdk/collections/hashmap/put#putval-的五个阶段",
      "labMethod": "observeBasicPutAndReplace",
      "testClass": "io.github.javasourceatlas.jdk.collection.HashMapBehaviorTest",
      "testMethod": "shouldReplaceValueWithoutIncreasingSize",
      "expectedOutcome": "第二次 put 返回旧值，size 保持 1，get 返回替换后的新值。"
    },
    {
      "id": "resize-boundary",
      "kind": "boundary",
      "claim": "HashMap 扩容迁移后所有旧映射仍可按原 key 读取，容量变化不改变 Map 契约。",
      "entryPoint": "resize()",
      "document": "/jdk/collections/hashmap/resize",
      "labMethod": "observeResize",
      "testClass": "io.github.javasourceatlas.jdk.collection.HashMapBehaviorTest",
      "testMethod": "shouldKeepMappingsAfterResize",
      "expectedOutcome": "从小容量连续写入 1000 个映射后 size 正确，逐个 key 都能读回对应 value。"
    },
    {
      "id": "treeify-boundary",
      "kind": "boundary",
      "claim": "容量达到 64 后，同一桶中的足量碰撞节点会进入树化路径且仍以 equals 区分键。",
      "entryPoint": "treeifyBin(Node[],int)",
      "document": "/jdk/collections/hashmap/treeify#treeifybin-并不总是树化",
      "labMethod": "observeTreeification",
      "testClass": "io.github.javasourceatlas.jdk.collection.HashMapBehaviorTest",
      "testMethod": "shouldKeepCollidingKeysDistinct",
      "expectedOutcome": "20 个相同 hash、不同 equals 的键全部保留并能分别读取，treeifyBin 断点被稳定触发。"
    }
  ],
