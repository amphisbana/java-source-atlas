  "evidence": [
    {
      "id": "ordering-main",
      "kind": "main",
      "claim": "TreeMap 用 compare 结果同时决定查找方向与键身份，覆盖已有键不会改变大小。",
      "entryPoint": "put(K,V)",
      "document": "/jdk/collections/treemap/#put-的查找、覆盖与接入",
      "labMethod": "observeOrderingAndReplacement",
      "testClass": "io.github.javasourceatlas.jdk.collection.TreeMapBehaviorTest",
      "testMethod": "shouldOrderNaturallyAndReplaceExistingValue",
      "expectedOutcome": "键按自然顺序迭代，重复键返回旧值、更新新值且 size 不增加。"
    },
    {
      "id": "navigation-boundary",
      "kind": "boundary",
      "claim": "ceiling/floor 与 higher/lower 分别表达包含边界和严格边界，搜索中会保留最近候选。",
      "entryPoint": "getCeilingEntry(K)",
      "document": "/jdk/collections/treemap/navigation-view#getceilingentry-如何保留候选答案",
      "labMethod": "observeNavigation",
      "testClass": "io.github.javasourceatlas.jdk.collection.TreeMapBehaviorTest",
      "testMethod": "shouldNavigateStrictAndInclusiveBoundaries",
      "expectedOutcome": "存在键和间隙键的四种导航结果都精确符合包含或排除边界的定义。"
    },
    {
      "id": "deletion-cleanup",
      "kind": "cleanup",
      "claim": "删除节点后 fixAfterDeletion 通过旋转与染色恢复红黑树不变量，同时保持剩余映射。",
      "entryPoint": "deleteEntry(Entry)",
      "document": "/jdk/collections/treemap/put-balance#删除先把问题压缩到至多一个孩子",
      "labMethod": "observeDeletionRepairBranches",
      "testClass": "io.github.javasourceatlas.jdk.collection.TreeMapBehaviorTest",
      "testMethod": "shouldPreserveMappingsAcrossDeletionRepairScenarios",
      "expectedOutcome": "多组固定删除序列执行后剩余键仍有序、值未丢失且所有查询结果正确。"
    }
  ],
