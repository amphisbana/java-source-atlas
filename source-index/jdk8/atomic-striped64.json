  "evidence": [
    {
      "id": "cas-main",
      "kind": "main",
      "claim": "compareAndSet 只在当前值等于期望值时原子更新，失败时不覆盖现值。",
      "entryPoint": "AtomicInteger.compareAndSet(int,int)",
      "document": "/jdk/concurrent/atomic/atomic-integer#compareandset-的判定边界",
      "labMethod": "observeCompareAndSet",
      "testClass": "io.github.javasourceatlas.jdk.concurrent.AtomicBehaviorTest",
      "testMethod": "shouldSucceedAndFailCompareAndSetByExpectedValue",
      "expectedOutcome": "第一次 CAS 成功并写入新值，使用过期期望值的第二次 CAS 失败且数值不变。"
    },
    {
      "id": "lost-update-concurrency",
      "kind": "concurrency",
      "claim": "volatile 读写不能把复合自增变成原子操作，AtomicInteger 的原子 RMW 可以避免稳定复现的丢失更新。",
      "entryPoint": "AtomicInteger.getAndAdd(int)",
      "document": "/jdk/concurrent/atomic/atomic-integer#getandadd-为什么能避免丢失更新",
      "labMethod": "observeAtomicCounterContrast",
      "testClass": "io.github.javasourceatlas.jdk.concurrent.AtomicBehaviorTest",
      "testMethod": "shouldContrastStableLostUpdateWithAtomicIncrement",
      "expectedOutcome": "受控竞争下普通计数器少一次更新，而 AtomicInteger 精确得到全部线程的增量。"
    },
    {
      "id": "update-retry-boundary",
      "kind": "boundary",
      "claim": "updateAndGet 在竞争失败后会重新读取并再次调用更新函数，因此函数必须无副作用。",
      "entryPoint": "AtomicInteger.updateAndGet(IntUnaryOperator)",
      "document": "/jdk/concurrent/atomic/atomic-integer#函数更新为什么要求无副作用",
      "labMethod": "observeUpdateFunctionRetry",
      "testClass": "io.github.javasourceatlas.jdk.concurrent.AtomicBehaviorTest",
      "testMethod": "shouldRetryUpdateFunctionAfterCompetingUpdate",
      "expectedOutcome": "竞争线程插入更新后，更新函数至少执行两次，最终值基于最新状态计算。"
    }
  ],
