  "evidence": [
    {
      "id": "clear-enqueue-main",
      "kind": "main",
      "claim": "Reference.clear 只清空 referent，enqueue 才把引用对象放入 ReferenceQueue，两者是独立动作。",
      "entryPoint": "Reference.clear()",
      "document": "/jdk/runtime/reference-weakhashmap/reference-processing#clear-与-enqueue-不能混为一个动作",
      "labMethod": "observeExplicitQueueProtocol",
      "testClass": "io.github.javasourceatlas.jdk.reference.ReferenceWeakHashMapBehaviorTest",
      "testMethod": "shouldSeparateClearFromEnqueue",
      "expectedOutcome": "clear 后 get 返回 null 但 queue 为空；显式 enqueue 后 poll 才返回该引用。"
    },
    {
      "id": "phantom-boundary",
      "kind": "boundary",
      "claim": "PhantomReference 的 get 永远返回 null，只能通过 ReferenceQueue 感知可回收阶段。",
      "entryPoint": "PhantomReference.get()",
      "document": "/jdk/runtime/reference-weakhashmap/reference-processing#phantomreference",
      "labMethod": "observePhantomReference",
      "testClass": "io.github.javasourceatlas.jdk.reference.ReferenceWeakHashMapBehaviorTest",
      "testMethod": "shouldExposeNullFromPhantomReference",
      "expectedOutcome": "创建前后和入队后 get 均为 null，引用对象可通过队列被取回。"
    },
    {
      "id": "queue-wait-cleanup",
      "kind": "cleanup",
      "claim": "ReferenceQueue.remove 的等待与超时契约允许清理线程阻塞等待引用到达，并在超时后返回空。",
      "entryPoint": "ReferenceQueue.poll/remove(long)",
      "document": "/jdk/runtime/reference-weakhashmap/reference-processing#referencequeue-的三种消费方式",
      "labMethod": "observeExplicitQueueProtocol",
      "testClass": "io.github.javasourceatlas.jdk.reference.ReferenceWeakHashMapBehaviorTest",
      "testMethod": "shouldKeepReferenceQueueWaitContractAcrossVersions",
      "expectedOutcome": "空队列超时等待不会伪造引用，入队后 remove 能取到唯一目标引用。"
    }
  ],
