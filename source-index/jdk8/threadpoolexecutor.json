  "evidence": [
    {
      "id": "execute-reject-main",
      "kind": "main",
      "claim": "execute 按核心线程、队列、非核心线程三步决策；三处都无容量后进入拒绝策略。",
      "entryPoint": "execute(Runnable)",
      "document": "/jdk/concurrent/threadpoolexecutor/#execute-的三步决策",
      "labMethod": "observeExecuteDecision",
      "testClass": "io.github.javasourceatlas.jdk.concurrent.ThreadPoolExecutorBehaviorTest",
      "testMethod": "shouldRejectWhenWorkersAndQueueAreFull",
      "expectedOutcome": "核心与最大线程数已满且队列已满时，新任务稳定触发 RejectedExecutionException。"
    },
    {
      "id": "caller-runs-boundary",
      "kind": "boundary",
      "claim": "CallerRunsPolicy 在未关闭的饱和池中把被拒任务同步交给提交线程执行，形成反压。",
      "entryPoint": "reject(Runnable)",
      "document": "/jdk/concurrent/threadpoolexecutor/shutdown-reject#四种内置拒绝策略",
      "labMethod": "observeCallerRuns",
      "testClass": "io.github.javasourceatlas.jdk.concurrent.ThreadPoolExecutorBehaviorTest",
      "testMethod": "shouldRunRejectedTaskInCallerThread",
      "expectedOutcome": "拒绝任务没有丢失，执行线程名称等于调用 execute 的线程名称。"
    },
    {
      "id": "graceful-shutdown-cleanup",
      "kind": "cleanup",
      "claim": "shutdown 不接收新任务但会排空队列，并且不应中断正在执行的 Worker。",
      "entryPoint": "shutdown()",
      "document": "/jdk/concurrent/threadpoolexecutor/shutdown-reject#shutdown-是有序关闭",
      "labMethod": "observeGracefulShutdown",
      "testClass": "io.github.javasourceatlas.jdk.concurrent.ThreadPoolExecutorBehaviorTest",
      "testMethod": "shouldDrainQueueDuringGracefulShutdown",
      "expectedOutcome": "已提交任务全部完成，shutdown 后新任务被拒绝，线程池最终进入 TERMINATED。"
    }
  ],
