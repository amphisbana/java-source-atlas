  "evidence": [
    {
      "id": "growth-main",
      "kind": "main",
      "claim": "ArrayList 扩容后保持元素顺序，新增元素落在原有元素之后。",
      "entryPoint": "add(E)",
      "document": "/jdk/collections/arraylist/#add-e-调用链",
      "labMethod": "observeGrowth",
      "testClass": "io.github.javasourceatlas.jdk.collection.ArrayListBehaviorTest",
      "testMethod": "shouldKeepOrderAfterGrowth",
      "expectedOutcome": "连续写入触发扩容后，列表大小、顺序和每个下标对应的值全部保持正确。"
    },
    {
      "id": "middle-mutation-boundary",
      "kind": "boundary",
      "claim": "中间位置的插入与删除依赖数组搬移，但不会破坏剩余元素的相对顺序。",
      "entryPoint": "remove(int)",
      "document": "/jdk/collections/arraylist/mutation#删除为什么要清空尾部",
      "labMethod": "observeMiddleMutation",
      "testClass": "io.github.javasourceatlas.jdk.collection.ArrayListBehaviorTest",
      "testMethod": "shouldShiftElementsForMiddleMutation",
      "expectedOutcome": "中间插入后后缀整体右移，中间删除后后缀整体左移，最终顺序与预期一致。"
    },
    {
      "id": "iterator-fail-fast",
      "kind": "failure",
      "claim": "迭代器创建后的结构性修改会通过 modCount 检查快速失败。",
      "entryPoint": "Itr.next()",
      "document": "/jdk/collections/arraylist/iterator-version#fail-fast-如何发生",
      "labMethod": "observeFailFast",
      "testClass": "io.github.javasourceatlas.jdk.collection.ArrayListBehaviorTest",
      "testMethod": "shouldFailFastAfterStructuralModification",
      "expectedOutcome": "列表结构变化后继续调用旧迭代器 next，稳定抛出 ConcurrentModificationException。"
    }
  ],
