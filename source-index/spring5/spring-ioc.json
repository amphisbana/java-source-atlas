  "evidence": [
    {
      "id": "bean-lifecycle-main",
      "kind": "main",
      "claim": "refresh 会先处理 BeanDefinition，再创建单例并按属性填充、Aware、前后处理器、初始化和销毁顺序推进生命周期。",
      "entryPoint": "AbstractApplicationContext.refresh()",
      "document": "/spring/ioc/refresh",
      "labMethod": "main",
      "testClass": "io.github.javasourceatlas.spring.ioc.SpringIocLifecycleTest",
      "testMethod": "shouldRunDefinitionAndBeanLifecycleInOrder",
      "expectedOutcome": "事件序列严格满足 BFPP 早于实例化、属性早于 Aware、初始化前后处理器包围 init，关闭时执行 destroy。"
    },
    {
      "id": "factory-bean-boundary",
      "kind": "boundary",
      "claim": "普通 Bean 名取得 FactoryBean 产品，& 前缀取得工厂自身，单例产品会被缓存复用。",
      "entryPoint": "FactoryBeanRegistrySupport.getObjectFromFactoryBean(...)",
      "document": "/spring/ioc/extension-points#factorybean-名称有两种取值语义",
      "labMethod": "main",
      "testClass": "io.github.javasourceatlas.spring.ioc.SpringIocLifecycleTest",
      "testMethod": "shouldDistinguishFactoryBeanFromItsProduct",
      "expectedOutcome": "两次普通名称查询返回同一产品实例，&traceProduct 返回 FactoryBean 对象。"
    },
    {
      "id": "dependency-ambiguity-failure",
      "kind": "failure",
      "claim": "按类型注入剩余多个等价候选且没有 Primary、Qualifier 或名称裁决时，容器必须拒绝猜测。",
      "entryPoint": "DefaultListableBeanFactory.doResolveDependency(DependencyDescriptor,String,Set,TypeConverter)",
      "document": "/spring/ioc/dependency-resolution#doresolvedependency-的主线",
      "labMethod": "main",
      "testClass": "io.github.javasourceatlas.spring.ioc.DependencyResolutionBehaviorTest",
      "testMethod": "shouldFailWhenSingleDependencyRemainsAmbiguous",
      "expectedOutcome": "上下文 refresh 失败，最深层原因是 NoUniqueBeanDefinitionException，并列出冲突候选。"
    }
  ],
