    {
      "method": "DefaultListableBeanFactory.resolveDependency(DependencyDescriptor,String,Set,TypeConverter)",
      "document": "/spring/ioc/dependency-resolution#resolvedependency-先处理特殊包装",
      "purpose": "识别 Optional、ObjectProvider、Lazy 与普通依赖解析入口",
      "sourceClass": "org.springframework.beans.factory.support.DefaultListableBeanFactory"
    },
    {
      "method": "DefaultListableBeanFactory.doResolveDependency(DependencyDescriptor,String,Set,TypeConverter)",
      "document": "/spring/ioc/dependency-resolution#doresolvedependency-的主线",
      "purpose": "处理快捷值、建议值、名称匹配、多值分流、候选收集和唯一性裁决",
      "sourceClass": "org.springframework.beans.factory.support.DefaultListableBeanFactory",
      "summary": "普通依赖解析的决策管线：先处理快捷引用和 @Value，再尝试名称与集合注入，最后收集候选并按 @Primary、优先级和名称裁决唯一 Bean。",
      "process": [
        "让 DependencyDescriptor.resolveShortcut 尝试框架或用户提供的快捷结果。",
        "读取 AutowireCandidateResolver 建议值，解析占位符和表达式并转换为目标类型。",
        "按 dependencyName 或 suggestedName 尝试名称直达，同时校验类型、自动装配资格和自引用边界。",
        "通过 resolveMultipleBeans 分流数组、Collection、Map 和 Stream 等多值依赖。",
        "调用 findAutowireCandidates 收集候选；为空时根据 required 和 fallback 规则处理。",
        "多个候选通过 determineAutowireCandidate 按 Primary、优先级和名称选择，最后 resolveCandidate 并登记依赖关系。"
      ],
      "designInsights": [
        "依赖解析不是简单的按类型查 Map，而是一条可扩展决策链；DependencyDescriptor 与 AutowireCandidateResolver 把注入点语义和候选资格封装起来。",
        "单值和多值依赖在同一入口尽早分流，使集合注入可以保留排序信息而单值注入执行唯一性裁决。"
      ],
      "pitfalls": [
        "@Qualifier 主要参与候选资格过滤，不是所有候选产生后才进行的最终排序。",
        "@Primary 只能解决单值候选冲突；集合注入通常会保留全部合格候选。"
      ],
