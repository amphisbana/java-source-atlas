  "entryPoints": [
    {
      "method": "AbstractApplicationContext.refresh()",
      "document": "/spring/ioc/refresh",
      "purpose": "编排上下文准备、工厂扩展、单例预实例化与刷新完成",
      "summary": "Spring 容器启动的总模板：在 startupShutdownMonitor 保护下依次准备上下文、刷新 BeanFactory、调用扩展点、注册基础设施并预实例化单例，失败时统一销毁和复位状态。",
      "process": [
        "prepareRefresh 初始化启动时间、active/closed 标记、Environment 和早期事件集合。",
        "obtainFreshBeanFactory 创建或刷新内部 BeanFactory，并加载 BeanDefinition。",
        "prepareBeanFactory 注册类加载器、表达式解析器、环境依赖和基础 BeanPostProcessor。",
        "依次执行 postProcessBeanFactory、invokeBeanFactoryPostProcessors 和 registerBeanPostProcessors。",
        "初始化消息源、事件广播器、子类特殊 Bean，并注册监听器。",
        "finishBeanFactoryInitialization 冻结配置并预实例化非懒加载单例，最后 finishRefresh 发布完成事件。",
        "任意异常都会 destroyBeans、cancelRefresh 后重新抛出，finally 清理公共反射缓存。"
      ],
      "designInsights": [
        "refresh 是模板方法与扩展点编排器：固定不可颠倒的生命周期骨架，同时把容器差异留给子类 Hook、BeanFactoryPostProcessor 和 BeanPostProcessor。",
        "扩展处理器分阶段执行，确保修改 BeanDefinition 的逻辑发生在普通 Bean 实例化之前。"
      ],
      "pitfalls": [
        "refresh 不等同于创建所有 Bean；懒加载、非单例和某些 FactoryBean 产品会在后续真正请求时创建。",
        "BeanFactoryPostProcessor 修改的是定义元数据，BeanPostProcessor 处理的是实例，两者执行时机完全不同。"
      ],
      "relatedMethods": [
        {
          "method": "PostProcessorRegistrationDelegate.invokeBeanFactoryPostProcessors(...)",
          "relation": "定义扩展阶段",
          "reason": "Bean 实例化前先允许注册和修改 BeanDefinition。"
        },
        {
          "method": "AbstractBeanFactory.doGetBean(String,Class,Object[],boolean)",
          "relation": "实例获取主线",
          "reason": "预实例化单例最终会进入统一的 Bean 获取与创建协议。"
        },
        {
