      "variables": [
        "descriptor",
        "candidates",
        "primaryCandidate",
        "exception.mostSpecificCause"
      ]
    },
    {
      "method": "DefaultListableBeanFactory.doResolveDependency(DependencyDescriptor,String,Set,TypeConverter)",
      "scenario": "刷新歧义依赖上下文，观察候选集合无法通过 Primary、Qualifier 或名称完成裁决",
      "variables": [
        "descriptor",
        "beanName",
        "matchingBeans",
        "autowiredBeanNames"
      ],
      "evidenceId": "dependency-ambiguity-failure"
    }
  ]
