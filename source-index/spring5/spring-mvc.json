  "evidence": [
    {
      "id": "dispatch-main",
      "kind": "main",
      "claim": "DispatcherServlet 选择 Handler、解析参数、调用控制器并通过消息转换器写出响应。",
      "entryPoint": "DispatcherServlet.doDispatch(HttpServletRequest,HttpServletResponse)",
      "document": "/spring/mvc/dispatch-chain",
      "labMethod": "runRequest",
      "testClass": "io.github.javasourceatlas.spring.mvc.SpringMvcBehaviorTest",
      "testMethod": "shouldResolveArgumentsAndWriteResponse",
      "expectedOutcome": "GET 请求的路径变量与查询参数正确注入，响应状态、媒体类型和正文全部符合预期。"
    },
    {
      "id": "method-condition-boundary",
      "kind": "boundary",
      "claim": "路径匹配但 HTTP method 条件不满足时不会进入控制器，而由 handleNoMatch 生成 405。",
      "entryPoint": "RequestMappingInfoHandlerMapping.handleNoMatch(Set<RequestMappingInfo>,String,HttpServletRequest)",
      "document": "/spring/mvc/dispatch-chain",
      "labMethod": "runUnsupportedMethodRequest",
      "testClass": "io.github.javasourceatlas.spring.mvc.SpringMvcBehaviorTest",
      "testMethod": "shouldRejectUnsupportedHttpMethod",
      "expectedOutcome": "POST 请求命中同一路径但返回 405，并在 Allow 响应头声明支持的方法。"
    },
    {
      "id": "exception-resolver-failure",
      "kind": "failure",
      "claim": "控制器异常会回到 processHandlerException，并由匹配的 @ExceptionHandler 转换为业务响应。",
      "entryPoint": "DispatcherServlet.processHandlerException(HttpServletRequest,HttpServletResponse,Object,Exception)",
      "document": "/spring/mvc/argument-return-exception",
      "labMethod": "runRequest",
      "testClass": "io.github.javasourceatlas.spring.mvc.SpringMvcBehaviorTest",
      "testMethod": "shouldResolveControllerException",
      "expectedOutcome": "异常没有泄漏到 MockMvc 调用方，最终响应使用全局异常处理器定义的状态码和正文。"
    }
  ],
