    },
    {
      "method": "RuleBasedTransactionAttribute.rollbackOn(Throwable)",
      "document": "/spring/transaction/commit-rollback",
      "purpose": "按异常继承距离选择最具体的 rollback 或 no-rollback 规则"
    }
  ],
  "breakpoints": [
    {
      "method": "TransactionInterceptor.invoke(MethodInvocation)",
      "scenario": "确认客户端调用真正进入事务代理，并取得实际 targetClass",
      "variables": ["invocation.method", "invocation.this", "targetClass"]
    },
    {
      "method": "TransactionAspectSupport.invokeWithinTransaction(...)",
      "scenario": "观察事务属性、管理器、joinpoint 名称和 TransactionInfo 调用栈",
      "variables": ["txAttr", "tm", "joinpointIdentification", "txInfo"]
    },
    {
      "method": "AbstractPlatformTransactionManager.handleExistingTransaction(...)",
      "scenario": "对比 REQUIRED 参与、REQUIRES_NEW 挂起与 NESTED 保存点分支",
      "variables": ["definition.propagationBehavior", "transaction", "suspendedResources", "status"]
    },
    {
      "method": "AbstractPlatformTransactionManager.commit(TransactionStatus)",
      "scenario": "定位正常返回为何被 rollback-only 改写为回滚",
      "variables": ["status.localRollbackOnly", "status.globalRollbackOnly", "status.newTransaction"]
    },
    {
      "method": "AbstractPlatformTransactionManager.processRollback(...)",
      "scenario": "区分保存点回滚、物理回滚和参与者标记共享事务",
      "variables": ["status.hasSavepoint", "status.newTransaction", "unexpected", "globalRollbackOnParticipationFailure"]
    },
    {
      "method": "RecordingTransactionManager.doSuspend(Object)",
      "sourceClass": null,
      "scenario": "在教学 Lab 中观察 tx-1 解绑、tx-2 运行和 tx-1 恢复的精确顺序",
      "variables": ["transaction.resource", "boundResource", "TransactionEvents"]
    }
  ]
