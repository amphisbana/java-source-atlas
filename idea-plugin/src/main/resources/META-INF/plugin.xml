<idea-plugin>
    <id>io.github.java-source-atlas.idea</id>
    <name>Java Source Atlas</name>
    <vendor url="https://github.com/amphisbana/java-source-atlas">Java Source Atlas</vendor>

    <description><![CDATA[
      Java Source Atlas connects JDK and Spring source guides directly to the IntelliJ IDEA editor.
      Java Source Atlas 将 JDK 与 Spring 源码教程带到 IntelliJ IDEA 的阅读现场。
      插件根据当前 Java 类和方法匹配教程、源码入口和推荐断点，并支持从工具窗口反向跳转源码。
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>JUnit</depends>
    <depends optional="true" config-file="jcef.xml">com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="io.github.javasourceatlas.idea.index.AtlasIndexService"/>
        <applicationService serviceImplementation="io.github.javasourceatlas.idea.learning.AtlasLearningProgressState"/>
        <applicationService serviceImplementation="io.github.javasourceatlas.idea.settings.AtlasSettingsState"/>
        <projectService serviceImplementation="io.github.javasourceatlas.idea.debug.AtlasBreakpointState"/>
        <projectService serviceImplementation="io.github.javasourceatlas.idea.debug.AtlasDebugGuidanceService"/>
        <applicationConfigurable
                id="io.github.javasourceatlas.idea.settings"
                displayName="Java Source Atlas"
                instance="io.github.javasourceatlas.idea.settings.AtlasConfigurable"/>
        <toolWindow
                id="Source Atlas"
                anchor="right"
                icon="/icons/atlas.svg"
                factoryClass="io.github.javasourceatlas.idea.ui.AtlasToolWindowFactory"/>
        <codeInsight.lineMarkerProvider
                language="JAVA"
                implementationClass="io.github.javasourceatlas.idea.gutter.AtlasLineMarkerProvider"/>
    </extensions>

    <actions>
        <action
                id="JavaSourceAtlas.OpenDocumentation"
                class="io.github.javasourceatlas.idea.action.AtlasOpenDocumentationAction"
                text="在 Source Atlas 中查看解析"
                description="打开当前 Java 类或方法对应的源码解析"
                icon="/icons/atlas.svg">
            <!-- 2026-08-24：原动作直接占用编辑器和 Tools 菜单，新增上下文动作后统一收进 Source Atlas 子菜单。 -->
            <!-- <add-to-group group-id="EditorPopupMenu" anchor="last"/> -->
            <!-- <add-to-group group-id="ToolsMenu" anchor="last"/> -->
        </action>
        <action
                id="JavaSourceAtlas.NavigateSource"
                class="io.github.javasourceatlas.idea.action.AtlasNavigateSourceAction"
                text="定位当前源码入口"
                description="定位当前类或方法对应的 Source Atlas 源码入口"
                icon="/icons/atlas.svg"/>
        <action
                id="JavaSourceAtlas.AddRecommendedBreakpoint"
                class="io.github.javasourceatlas.idea.action.AtlasAddRecommendedBreakpointAction"
                text="添加当前方法推荐断点"
                description="添加当前源码入口对应的 Source Atlas 推荐断点"
                icon="/icons/atlas.svg"/>
        <action
                id="JavaSourceAtlas.TranslateComment"
                class="io.github.javasourceatlas.idea.action.AtlasTranslateCommentAction"
                text="翻译当前源码注释"
                description="使用 Translation 插件翻译当前注释；未安装时显示安装引导"
                icon="/icons/atlas.svg"/>
        <action
                id="JavaSourceAtlas.DebugEvidence"
                class="io.github.javasourceatlas.idea.action.AtlasDebugEvidenceAction"
                text="Debug 当前证据场景"
                description="添加推荐断点并 Debug 当前方法对应的证据测试"
                icon="/icons/atlas.svg"/>
        <action
                id="JavaSourceAtlas.NextEntry"
                class="io.github.javasourceatlas.idea.action.AtlasNextEntryAction"
                text="进入调用链下一入口"
                description="定位当前专题调用链中的下一个源码入口"
                icon="/icons/atlas.svg"/>
        <action
                id="JavaSourceAtlas.ToggleFavorite"
                class="io.github.javasourceatlas.idea.action.AtlasToggleFavoriteAction"
                text="收藏或取消收藏当前专题"
                description="切换当前源码专题的本地收藏状态"
                icon="/icons/atlas.svg"/>
        <group
                id="JavaSourceAtlas.EditorActions"
                text="Java Source Atlas"
                description="当前源码上下文的阅读、断点与证据操作"
                popup="true"
                icon="/icons/atlas.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <reference ref="JavaSourceAtlas.OpenDocumentation"/>
            <reference ref="JavaSourceAtlas.NavigateSource"/>
            <reference ref="JavaSourceAtlas.TranslateComment"/>
            <separator/>
            <reference ref="JavaSourceAtlas.AddRecommendedBreakpoint"/>
            <reference ref="JavaSourceAtlas.DebugEvidence"/>
            <separator/>
            <reference ref="JavaSourceAtlas.NextEntry"/>
            <reference ref="JavaSourceAtlas.ToggleFavorite"/>
        </group>
    </actions>
</idea-plugin>
